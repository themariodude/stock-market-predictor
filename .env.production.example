# Template only. Use independently generated production credentials.
# Store in /etc/stock-market-predictor/production.env on the production host,
# owned by root with mode 0600. See README-US60.md.
APP_ENV=production
GHCR_OWNER=replace-with-github-owner
IMAGE_TAG=replace-with-git-sha

POSTGRES_USER=smp
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=smp
DATABASE_URL='postgresql+psycopg://smp:replace-with-secure-password@db:5432/smp'
AUTH_SECRET_KEY=replace-with-a-unique-random-secret
DEMO_INVESTOR_EMAIL=replace-with-investor-email
DEMO_INVESTOR_PASSWORD_HASH='replace-with-generated-pbkdf2-hash'

BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=https://api.example.invalid
CORS_ORIGINS=https://app.example.invalid
LOG_LEVEL=INFO
FRED_API_KEY=

# Template only. Store real values in /etc/stock-market-predictor/staging.env
# on the staging host, owned by root with mode 0600. See README-US60.md.
APP_ENV=staging

GHCR_OWNER=replace-with-github-owner
IMAGE_TAG=replace-with-git-sha

POSTGRES_USER=smp
POSTGRES_PASSWORD=replace-with-secure-password
POSTGRES_DB=smp

# Single quotes preserve literal dollar signs in Compose environment files.
DATABASE_URL='postgresql+psycopg://smp:replace-with-secure-password@db:5432/smp'
AUTH_SECRET_KEY=replace-with-a-unique-random-secret
DEMO_INVESTOR_EMAIL=replace-with-investor-email
DEMO_INVESTOR_PASSWORD_HASH='replace-with-generated-pbkdf2-hash'

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Replace with the real staging backend address.
VITE_API_BASE_URL=http://STAGING_HOST:8000

# Allow the staging frontend to call the backend.
CORS_ORIGINS=http://STAGING_HOST:5173

LOG_LEVEL=INFO
FRED_API_KEY=

# Copy to .env before running:  cp .env.example .env
# .env is gitignored. Never commit real credentials.

# Keep these four in sync with DATABASE_URL below.
POSTGRES_USER=smp
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smp
POSTGRES_PORT=5432

# Host is `db` — the compose service name, not localhost.
DATABASE_URL=postgresql+psycopg://smp:change-me@db:5432/smp

BACKEND_PORT=8000
LOG_LEVEL=INFO

# This one IS localhost — the browser makes the call, not the container.
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

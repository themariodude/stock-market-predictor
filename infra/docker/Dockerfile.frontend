# Development image. Production build comes in a later sprint.
FROM node:24-alpine

WORKDIR /app

# Update npm within the supported Node.js version range.
# Test this candidate before retaining it in the final image.
RUN npm install -g npm@11

# Lockfile first so this layer caches across source edits.
COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci

COPY frontend/ ./

EXPOSE 5173

# Allow Vite to accept connections outside the container.
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

# Python 3.12 on Debian Bookworm.
FROM python:3.12-slim-bookworm

# Unbuffered Python output.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install available Debian security updates.
# Remove package lists to keep the image smaller.
RUN apt-get update \
    && apt-get upgrade -y \
    && rm -rf /var/lib/apt/lists/*

# CI can install development dependencies.
ARG INSTALL_DEV=false

# Create non-root application user.
RUN useradd --create-home --uid 1000 --shell /bin/bash appuser \
    && mkdir -p /app \
    && chown appuser:appuser /app

WORKDIR /app

# Copy dependency files first for Docker caching.
COPY --chown=appuser:appuser backend/requirements.txt backend/requirements-dev.txt ./

# Install application dependencies.
# Upgrade setuptools only if already installed.
RUN python -m pip install --no-cache-dir --upgrade pip \
    && if [ "$INSTALL_DEV" = "true" ]; then \
         python -m pip install --no-cache-dir -r requirements-dev.txt; \
       else \
         python -m pip install --no-cache-dir -r requirements.txt; \
       fi \
    && if python -m pip show setuptools > /dev/null 2>&1; then \
         python -m pip install --no-cache-dir --upgrade "setuptools>=78.1.1"; \
       fi

# Copy backend application.
COPY --chown=appuser:appuser backend/ ./

USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
